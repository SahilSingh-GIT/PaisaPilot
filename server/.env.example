# ===============================================
# PaisaPilot Server Environment Configuration
# Copy this file to .env and fill in your secrets
# ===============================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection URL
# Replace placeholders with your actual NeonDB credentials:
DATABASE_URL="postgresql://<username>:<password>@<ep-hostname>.neon.tech/<dbname>?sslmode=require"

# Client URL (for CORS allowance)
CLIENT_ORIGIN=http://localhost:5173

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
